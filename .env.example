# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TICKERALL_BASE_URL: Base URL for your TickerAll market data API.
TICKERALL_BASE_URL="https://api.tickerall.com"

# TICKERALL_API_KEY: Fallback server-side API token if not configured in /admin dashboard.
# Injected by server.ts on upstream TickerAll proxy requests (never exposed to browser).
TICKERALL_API_KEY=""

# ADMIN_PASSWORD: Password to access the /admin dashboard.
ADMIN_PASSWORD=""

# KEY_ENCRYPTION_SECRET: 32-byte secret used to encrypt stored API keys at rest.
KEY_ENCRYPTION_SECRET=""

# PORT: HTTP port bound by server.ts on startup (defaults to 3000; Railway sets PORT automatically).
PORT="3000"

# Telegram User API Signal Listener (MTProto User Account, NOT a Bot)
# Obtain API_ID and API_HASH at https://my.telegram.org
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_PHONE_NUMBER=""
TELEGRAM_CHANNEL=""
TELEGRAM_SESSION_STRING=""

